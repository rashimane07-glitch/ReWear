# MOCK mode (default): leave VITE_API_URL empty. No network; demo data and the demo login
# (demo@rewear.test / demo1234) work in the browser only.
#
# REAL mode: point it at the Express backend, then RESTART "npm run dev" (Vite reads this file only at start):
#   VITE_API_URL=http://localhost:5000/api/v1
# The backend (backend/.env) must have FRONTEND_URL=http://localhost:5173 (its default), or the browser
# blocks the calls (CORS). Copy this file to FRONTEND/.env and edit the copy; never commit .env.
VITE_API_URL=
