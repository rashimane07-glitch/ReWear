# ============================================================
# ReWear backend - environment variables
#
# HOW TO USE:
#   1. Copy this file to a new file named ".env" (same folder).
#   2. Fill in your own values in ".env".
#   3. NEVER commit ".env" to Git. It is listed in .gitignore.
#
# This file (.env.example) is safe to commit: it holds NO real secrets.
# Every variable below is optional for now. The server starts without them.
# ============================================================

# --- Server ---------------------------------------------------
# Port the backend listens on (default: 5000)
PORT=5000

# "development" or "production" (default: development)
NODE_ENV=development

# Address of the React frontend. Used for CORS so the browser allows
# the frontend to call this API (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# --- Authentication (needed for register / login) -------------
# Secret key used to sign login tokens (JWT). Keep it private, and use at
# least 32 characters. If it leaks, anyone can forge logins, so never commit it.
# Generate a long random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Paste the printed text after the equals sign. Leave blank until you have one:
# the server still starts, but register/login answer "not configured".
JWT_SECRET=
# How long a login token stays valid. Examples: 7d (7 days), 12h, 3600 (seconds)
JWT_EXPIRES_IN=7d

# --- IBM Cloudant database ------------------------------------
# Where to find these: IBM Cloud > your Cloudant instance > "Service credentials"
# > create/view a credential. Copy the "url" and "apikey" values.
# Leave them blank for now if you have not set up Cloudant yet:
# the server still starts, and /api/v1/health/database will tell you
# that Cloudant is not configured.
# NEVER share or commit your real API key.
#
# The instance address, e.g. https://xxxx.cloudantnosqldb.appdomain.cloud
CLOUDANT_URL=
# The IAM API key from the same service credentials
CLOUDANT_APIKEY=
# Name of the database ReWear uses (default: rewear)
CLOUDANT_DATABASE=rewear

# --- Local image storage: listing photos ----------------------
# Uploaded images are saved on this server in backend/uploads/ (the image
# files never go into the database) and served at <BACKEND_URL>/uploads/...
# The defaults work for local development: you can leave these as they are.
#
# Public address of this backend. It is put in front of image links, so the
# browser can load them. Use your real address when you deploy.
# (default: http://localhost:<PORT>)
BACKEND_URL=http://localhost:5000
# Optional. Folder for uploaded images, relative to the backend folder
# (default: uploads). It is ignored by Git.
# UPLOADS_DIR=uploads

# --- Demo data (npm run seed:demo) -----------------------------
# Optional. Password for the demo seller account (demo.seller@example.com)
# created by "npm run seed:demo". Set it BEFORE the first seed run if you
# want to log in as the demo seller (8+ characters). If empty, a random
# password is used and nobody can log in as the demo seller.
# Never commit your real value.
DEMO_SELLER_PASSWORD=
