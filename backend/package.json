{
  "name": "rewear-backend",
  "version": "1.0.0",
  "description": "Backend API for ReWear - Sustainable Fashion Marketplace",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/setup-database.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:dry": "node scripts/seed-demo.js --dry-run",
    "demo:restore-images": "node scripts/restore-demo-images.js",
    "demo:restore-images:dry": "node scripts/restore-demo-images.js --dry-run",
    "demo:seller-login": "node scripts/demo-seller-login.js",
    "demo:seller-login:dry": "node scripts/demo-seller-login.js --dry-run",
    "db:verify-browse": "node scripts/verify-browse.js",
    "admin:create": "node scripts/make-admin.js",
    "admin:demote": "node scripts/make-admin.js --demote",
    "db:verify-requests": "node scripts/verify-requests.js",
    "db:verify-reports": "node scripts/verify-reports.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ibm-cloud/cloudant": "0.12.27",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "debug": "4.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
